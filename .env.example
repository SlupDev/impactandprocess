# Copier vers .env.local et renseigner. Toute variable manquante fait échouer `pnpm build`
# (src/lib/env.ts est importé par next.config.ts).
#
# Règle 23 d’AGENTS.md : seules les variables NEXT_PUBLIC_ atteignent le navigateur.

# --- Public (inliné dans le bundle client) ---------------------------------
NEXT_PUBLIC_SITE_URL=https://impactandprocess.fr
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=impactandprocess.fr

# --- Supabase --------------------------------------------------------------
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=
# service_role : contourne la RLS. Jamais côté client, jamais dans un dépôt.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_GUIDES_BUCKET=guides

# --- Resend ----------------------------------------------------------------
RESEND_API_KEY=re_
RESEND_FROM=Impact & Process <guides@impactandprocess.fr>
RESEND_REPLY_TO=contact@impactandprocess.fr
CONTACT_NOTIFICATION_EMAIL=contact@impactandprocess.fr

# --- Stripe ----------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_
STRIPE_PRICE_HYBRID_FAT_BURNER=price_

# --- Protocole Virage (990 €) : réservation, pas de checkout ---------------
CALENDLY_URL=https://calendly.com/impactandprocess/protocole-virage

# --- Secrets applicatifs ---------------------------------------------------
# Générer avec : openssl rand -hex 32
IP_HASH_SALT=
